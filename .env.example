# =========================================
# LEARNSPHERE BACKEND ENVIRONMENT
# =========================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/learnsphere?retryWrites=true&w=majority

# Long random secret - minimum 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Allowed frontend origins, comma separated
ALLOWED_ORIGINS=https://thelearnsphere.in,https://www.thelearnsphere.in,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=learnsphere-pmp

# Gmail / Google Workspace notifications
# EMAIL_PASS must be a Google App Password.
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-google-app-password
RECEIVER_EMAIL=your-email@example.com

# One-time admin setup. Set TRUE only while creating/promoting the admin, then set FALSE.
ENABLE_ADMIN_SETUP=false
ADMIN_SETUP_SECRET=replace-with-a-long-random-setup-secret


# Production reverse proxy / scaling
# Set TRUST_PROXY=1 only when exactly one trusted reverse proxy/load balancer sits in front of Node.
TRUST_PROXY=0

# MongoDB connection pool tuning (per Node process)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_CONNECTING=2
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_MAX_IDLE_TIME_MS=60000

# Short-lived protected R2 media URL lifetime (60-900 seconds)
MEDIA_URL_EXPIRES_SECONDS=7200
